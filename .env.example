# Next.js / Vercel
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
# Public marketing destination. If blank, landing-page CTAs scroll to the lead form.
NEXT_PUBLIC_PRODUCT_SIGNUP_URL=
# Optional Meta Pixel for website-conversion ads.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional confirmed calendar URL displayed after an audit submission.
NEXT_PUBLIC_BOOKING_URL=
# Razorpay Payment Link for the agreed paid prototype. No customer data is sent automatically.
NEXT_PUBLIC_RAZORPAY_PILOT_PAYMENT_LINK=
# Set true only after the lead_created rule has an active campaign.
PUBLIC_LEAD_AUTOMATION_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_replace_me
# Full-access key used only by inbound Receiving API/webhook handlers. Keep it
# server-side; the sending key above may remain restricted to sending_access.
RESEND_RECEIVING_API_KEY=re_full_access_replace_me
RESEND_WEBHOOK_SECRET=whsec_replace_me
# Signing secret for the separate email.received webhook. If omitted, the
# inbound handler falls back to RESEND_WEBHOOK_SECRET.
RESEND_INBOUND_WEBHOOK_SECRET=whsec_inbound_replace_me
# Optional clean-start cutoff. Set to the reset time in ISO format before
# clearing inbox_threads/inbox_messages; older Resend retries are ignored.
INBOX_RESET_AT=
CRON_SECRET=replace-with-a-long-random-value

# Required for product-event automation. POST requests must include this value
# as x-marketing-secret or Authorization: Bearer <secret>.
MARKETING_WEBHOOK_SECRET=generate-a-long-random-secret
# Optional separate secret for the landing-page builder. If blank, the builder uses MARKETING_WEBHOOK_SECRET.
LANDING_PAGE_ADMIN_SECRET=

# Meta Lead Ads webhook
META_APP_SECRET=replace-with-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=generate-meta-webhook-verify-token
META_ACCESS_TOKEN=replace-with-meta-page-lead-access-token
META_GRAPH_API_VERSION=v23.0
META_AD_ACCOUNT_ID=act_replace_with_ad_account_id
META_ADS_ACCESS_TOKEN=replace-with-meta-ads-insights-token

# Calendly booking webhook
CALENDLY_WEBHOOK_SIGNING_KEY=replace-with-calendly-webhook-signing-key

# Razorpay payment and subscription webhook
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-a-separate-razorpay-webhook-secret

# Optional fallback campaign IDs. Prefer configuring them in /dashboard/automation.
MARKETING_CAMPAIGN_LEAD_ID=
MARKETING_CAMPAIGN_TRIAL_ID=
MARKETING_CAMPAIGN_ONBOARDING_ID=
MARKETING_CAMPAIGN_ACTIVATION_ID=
MARKETING_CAMPAIGN_DEMO_ID=
MARKETING_CAMPAIGN_TRIAL_WARNING_ID=
MARKETING_CAMPAIGN_TRIAL_EXPIRED_ID=
MARKETING_CAMPAIGN_PAID_ID=
MARKETING_CAMPAIGN_PAYMENT_FAILED_ID=
MARKETING_CAMPAIGN_WINBACK_ID

# Supabase Edge Function secret. Set to the same public application origin.
APP_BASE_URL=https://your-project.vercel.app
RESEND_DAILY_SEND_LIMIT=100
RESEND_MONTHLY_SEND_LIMIT=3000
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Required for reliable replies unless every sending domain has Resend Receiving
# and an inbound MX record. Set the same value in Vercel and Supabase Edge secrets.
REPLY_TO_EMAIL=replies@example.com
# Optional: forces all human Inbox replies to originate from one verified mailbox.
# Example: reply@modelingflow.info
INBOX_REPLY_FROM_EMAIL=
# Optional Outlook notification copy for each matched campaign reply. The
# FROM address must be a verified Resend sending address.
INBOX_FORWARD_TO_EMAIL=
INBOX_FORWARD_FROM_EMAIL=
